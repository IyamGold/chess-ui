{
  "name": "chess-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "compile": "hardhat compile --config hardhat.config.cjs",
    "deploy:fluent": "hardhat run scripts/deploy.cjs --network fluentTestnet --config hardhat.config.cjs",
    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "test:login": "node scripts/test-login-demo.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "test:landing": "node scripts/test-login-page.mjs",
    "test:dashboard": "node scripts/test-dashboard.mjs",
    "test:clocks": "npm --prefix server run test:clocks",
    "test:clocks-ui": "node scripts/test-clocks-ui.mjs",
    "test:reliability": "node --test scripts/test-game-state.mjs server/chess/stockfishPlayer.test.js server/events.test.js",
    "test:reliability-ui": "node scripts/test-game-reliability.mjs",
    "test:verification": "node --test server/login/index.test.js scripts/test-verification-state.mjs",
    "test:verification-ui": "node scripts/test-verification-ui.mjs",
    "test:verification:integration": "node --experimental-strip-types scripts/test-verification-integration.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "stockfish.js": "^10.0.2",
    "viem": "^2.22.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "hardhat": "^2.22.0",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.13 <23"
  }
}
