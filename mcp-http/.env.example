# Public URL of this MCP server. Used for OAuth metadata + redirect targets.
BASE_URL=http://localhost:3002

# Public URL of the chess UI (where the consent page lives at /mcp/consent).
CONSENT_UI_URL=http://localhost:5173

# Chess game server (server/) URL — used for /api/internal/* calls.
CHESS_SERVER_URL=http://localhost:3001

# Login.com passkey server URL — MCP proxy verifies passkey assertions here
# before forwarding identity claims to the chess server.
PASSKEY_SERVER_URL=http://localhost:3000

# Shared secret with the chess game server. Same value as MCP_SERVICE_SECRET on
# that service. Generate with: openssl rand -hex 32
MCP_SERVICE_SECRET=test_secret_local_only

# SQLite database path. On Railway, mount a volume and point this at it.
DATABASE_PATH=./mcp.db

# Port (Railway provides this; default for local dev).
PORT=3002

# Access token TTL (seconds). 1 hour default.
ACCESS_TOKEN_TTL=3600

# Refresh token TTL (seconds). 30 days default.
REFRESH_TOKEN_TTL=2592000
